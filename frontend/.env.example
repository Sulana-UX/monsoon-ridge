# Copy to `.env.local` and fill in from Firebase console > Project settings > Your apps.
# These are public identifiers (they end up in the browser), not secrets.
# Data is protected by Firestore rules + server checks, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=monsoon-ridge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=monsoon-ridge
VITE_FIREBASE_STORAGE_BUCKET=monsoon-ridge.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check (see README)
VITE_RECAPTCHA_SITE_KEY=

# true = use local emulators (npm run emulators) instead of the live project
VITE_USE_EMULATORS=false
