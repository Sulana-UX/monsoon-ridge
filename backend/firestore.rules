rules_version = '2';

// The browser can only READ, and only what it is allowed to see.
// All writes go through Cloud Functions (Admin SDK bypasses these rules),
// so prices, availability and status can never be changed from the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Any staff member (Admin or Front desk)
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Admin role only. Owners' older tokens have no role claim yet: they count as admin.
    function isManager() { return isAdmin() && request.auth.token.get('role', 'admin') == 'admin'; }

    match /bookings/{ref} {
      // Guests see their own bookings; staff see all of them.
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;

      // Staff-only notes on a booking. Guests can read their booking,
      // but never these. Written only through the API.
      match /notes/{noteId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Rooms: anyone can read rooms shown on the website; staff can read hidden ones too.
    // Changes only through the API (admin endpoints).
    match /rooms/{id} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // Room blocks (maintenance / private events): staff read, API-only writes.
    match /blocks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Season / weekend price rules and promo codes: staff read, API-only writes.
    // Guests never read these; they get a price quote from the API instead.
    match /settings/{id} {
      allow read: if isManager();
      allow write: if false;
    }
    match /promos/{code} {
      allow read: if isManager();
      allow write: if false;
    }

    // Contact-form messages: staff read (dashboard Inbox), API-only writes.
    match /messages/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Staff list (managed through the API) and the activity log.
    // Staff can read; nobody can write, edit or delete from the browser,
    // so the log can't be changed after the fact.
    match /staff/{email} {
      allow read: if isManager();
      allow write: if false;
    }
    match /activity/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Room numbers + housekeeping status: all staff read (front desk + admin), API-only writes.
    match /roomUnits/{number} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Guest reviews: published ones are public (website), staff also see hidden ones.
    // The document holds nothing private. Written only through the API.
    match /reviews/{ref} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    // Per-night room counts: server only.
    match /inventory/{id} {
      allow read, write: if false;
    }

    // Anything else: closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
