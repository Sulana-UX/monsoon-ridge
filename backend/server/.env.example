# Copy to `.env` (same folder) for local development. On Render, set these as
# Environment Variables in the dashboard instead.

PORT=8787

# Staff who get the Admin dashboard. Comma-separated, must be verified emails.
ADMIN_EMAILS=you@example.com

# Websites allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://monsoon-ridge.web.app,https://monsoon-ridge.firebaseapp.com

# Firebase Admin credentials (SECRET).
# Locally: leave this unset and save the key file as backend/server/service-account.json
# On Render: paste the whole JSON key file contents here.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudinary (room photo uploads). Dashboard → Settings → API Keys. Secret stays server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email through Brevo (free: 300/day). brevo.com → SMTP & API → API keys (SECRET).
# MAIL_FROM must be a sender you verified in Brevo (Senders, domains & IPs).
# Leave empty to run without email: bookings and messages still work.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Monsoon Ridge
# Who gets "new booking" / "new message" alerts (comma-separated). Default: ADMIN_EMAILS
STAFF_ALERT_EMAILS=
# Public website address, used for links inside emails
SITE_URL=https://monsoon-ridge.web.app
