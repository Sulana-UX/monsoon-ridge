# Copy this file to `.env` (same folder) and fill it in. It is deployed with the functions.

# Staff who get the Admin page. Comma-separated, must be verified emails.
ADMIN_EMAILS=you@example.com

# Websites allowed to call the functions (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://monsoon-ridge.web.app,https://monsoon-ridge.firebaseapp.com

# Set to true after App Check is registered for the web app (see README).
ENFORCE_APP_CHECK=false
