{
  "name": "monsoon-ridge",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "install:all": "npm --prefix frontend install && npm --prefix backend/server install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend/server test",
    "api": "npm --prefix backend/server run dev",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  }
}
